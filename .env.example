# ============================================================
# Software Provenance Tracker — Environment Configuration
# ============================================================
# Copy this file to .env and fill in ALL values.
# The system will NOT start with missing required values.
# There are NO mock data fallbacks — every key is mandatory.
# ============================================================

# ─── GitHub API ──────────────────────────────────────────────
# Required. Personal access token (classic) with scopes:
#   - repo (read access to commit history)
#   - read:org (read collaborator/member data)
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_pat_here

# ─── Package Registry APIs ──────────────────────────────────
# Direct registry endpoints. No Libraries.io.
PYPI_API_URL=https://pypi.org/pypi
NPM_REGISTRY_URL=https://registry.npmjs.org

# ─── PostgreSQL ──────────────────────────────────────────────
# Must match docker-compose.yml values exactly.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=provenance_db
POSTGRES_USER=provenance
POSTGRES_PASSWORD=your_postgres_password_here

# ─── Neo4j ───────────────────────────────────────────────────
# Must match docker-compose.yml values exactly.
NEO4J_HOST=localhost
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# ─── Redis ───────────────────────────────────────────────────
# Must match docker-compose.yml values exactly.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# ─── Application ─────────────────────────────────────────────
# Backend server configuration
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development
APP_LOG_LEVEL=INFO

# ─── Dependency Resolution ───────────────────────────────────
# Max depth for transitive dependency resolution (1-15)
MAX_DEPENDENCY_DEPTH=10

# Cache TTL for registry API responses (seconds)
# 3600 = 1 hour. Reduces redundant API calls.
REGISTRY_CACHE_TTL=3600

# ─── GitHub Rate Limiting ────────────────────────────────────
# GitHub allows 5000 req/hr with a token.
# Cache TTL for GitHub API responses (seconds)
GITHUB_CACHE_TTL=1800

# ─── Slack Notifications ─────────────────────────────────────
# Incoming webhook URL for alert notifications.
# Create at: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# ─── Email Notifications (SMTP) ──────────────────────────────
# SMTP server for sending alert emails.
# For Gmail: use an App Password, not your account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# ─── Frontend ────────────────────────────────────────────────
# Base URL of the frontend app (used in alert notification links)
FRONTEND_BASE_URL=http://localhost:5173
