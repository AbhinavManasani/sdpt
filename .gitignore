# Common ignores for Python and Node projects
# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.env

# Virtual environments
venv/
.env/

# Node.js
node_modules/
/dist/
/.pnp.*

# Logs and databases
logs/
*.log
*.sqlite3

# OS files
.DS_Store
Thumbs.db

# Build artifacts
build/

# IDE / editor configs
.vscode/
.idea/
*.sublime-workspace
*.sublime-project
